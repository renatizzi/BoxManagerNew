<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <include layout="@layout/layout_global_topbar"/>
    <include layout="@layout/layout_page_header"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- KPI -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="170dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:text="📦 Contenitori"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorSecondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="128"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:layout_height="wrap_content"/>

                            <com.google.android.material.floatingactionbutton.FloatingActionButton
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:src="@android:drawable/ic_input_add"
                                app:backgroundTint="?attr/colorSecondary"/>

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#22000000"/>

                        <TextView
                            android:text="di cui vuoti"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="12"
                            android:textSize="20sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="170dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:text="🏷 Categorie"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorSecondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="15"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:layout_height="wrap_content"/>

                            <com.google.android.material.floatingactionbutton.FloatingActionButton
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:src="@android:drawable/ic_input_add"
                                app:backgroundTint="?attr/colorSecondary"/>

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#22000000"/>

                        <TextView
                            android:text="di cui in uso"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="5"
                            android:textSize="20sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- RICERCA -->

            <TextView
                android:layout_marginTop="26dp"
                android:text="🔎 Ricerca archivio"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp">

                        <TextView
                            android:layout_width="118dp"
                            android:layout_height="match_parent"
                            android:text="Ambito di ricerca"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:background="#F5F1FA"/>

                        <Spinner
                            android:id="@+id/spinnerSearchScope"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"/>

                    </LinearLayout>

                    <EditText
                        android:id="@+id/editSearch"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:minHeight="54dp"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:inputType="text"
                        android:singleLine="true"
                        android:layout_marginTop="10dp"
                        android:hint="Cerca..."
                        android:drawableEnd="@android:drawable/ic_btn_speak_now"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ACCESSO RAPIDO -->

            <TextView
                android:layout_marginTop="18dp"
                android:text="⚡ Accesso rapido"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:columnCount="2">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="22dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="☁ Backup"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="?attr/colorSecondary"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="22dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="↺ Riprist."
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="?attr/colorSecondary"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="22dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="🛠 Utility"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="?attr/colorSecondary"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="22dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="▣ QR"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="?attr/colorSecondary"/>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

        </LinearLayout>

    </ScrollView>

    <include layout="@layout/layout_bottom_nav"/>

</LinearLayout>