<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNav"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="?attr/bottomNavBackgroundColor"
    android:elevation="6dp"
    android:weightSum="5"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">

    <TextView
        android:id="@+id/navDashboard"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/nav_dashboard"
        android:textStyle="bold"
        android:textSize="12sp"
        android:textColor="?attr/bottomNavInactiveColor"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:background="?attr/bottomNavBackgroundColor" />

    <TextView
        android:id="@+id/navBoxes"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/nav_boxes"
        android:textStyle="bold"
        android:textSize="12sp"
        android:textColor="?attr/bottomNavInactiveColor"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:background="?attr/bottomNavBackgroundColor" />

    <TextView
        android:id="@+id/navCategories"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/nav_categories"
        android:textStyle="bold"
        android:textSize="12sp"
        android:textColor="?attr/bottomNavInactiveColor"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:background="?attr/bottomNavBackgroundColor" />

    <TextView
        android:id="@+id/navUtility"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/nav_utility"
        android:textStyle="bold"
        android:textSize="12sp"
        android:textColor="?attr/bottomNavInactiveColor"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:background="?attr/bottomNavBackgroundColor" />

    <TextView
        android:id="@+id/navSettings"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/nav_settings_icon"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="?attr/bottomNavInactiveColor"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:background="?attr/bottomNavBackgroundColor" />

</LinearLayout>