<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categorie"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gestione categorie"
                android:textSize="13sp"
                android:textColor="#888888" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Aggiungi"
            android:src="@android:drawable/ic_input_add"
            app:backgroundTint="?attr/colorPrimary"
            app:tint="@android:color/white" />

    </LinearLayout>

    <!-- AREA CONTESTUALE UNIFICATA -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/contextCard"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:strokeWidth="2dp"
        app:strokeColor="@android:color/transparent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- SEARCH / SORT -->
            <LinearLayout
                android:id="@+id/layoutSearchSort"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="14dp">

                <EditText
                    android:id="@+id/editTextSearchCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Cerca per nome categoria"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/buttonSortCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ordina" />
            </LinearLayout>

            <!-- MESSAGGIO -->
            <TextView
                android:id="@+id/textContextMessage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:textSize="14sp"
                android:textColor="#333333"
                android:visibility="gone" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- LISTA -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewCategories"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false" />

    <!-- BOTTOM NAV -->
    <include layout="@layout/layout_bottom_nav" />

</LinearLayout>