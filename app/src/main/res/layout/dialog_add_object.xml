<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/textErrorObject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/common_required_field"
        android:textColor="#D32F2F"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <EditText
        android:id="@+id/editObjectName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/dialog_object_name_hint"
        android:imeOptions="actionNext"
        android:inputType="textCapWords"
        android:maxLines="1"
        android:minHeight="44dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:drawableEnd="@android:drawable/ic_btn_speak_now" />

    <EditText
        android:id="@+id/editObjectDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="@string/dialog_object_description_hint"
        android:imeOptions="actionNext"
        android:inputType="textCapSentences"
        android:maxLength="100"
        android:maxLines="2"
        android:minHeight="44dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:drawableEnd="@android:drawable/ic_btn_speak_now" />

    <EditText
        android:id="@+id/editObjectQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="@string/dialog_object_quantity_hint"
        android:imeOptions="actionDone"
        android:inputType="number"
        android:maxLines="1"
        android:minHeight="44dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:id="@+id/photoActionsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imageObjectPhotoPreview"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/object_photo_preview_cd"
            android:background="#22000000"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnObjectPhotoGallery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:gravity="center"
                android:text="@string/object_photo_from_gallery"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btnObjectPhotoCamera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:gravity="center"
                android:text="@string/object_photo_from_camera"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btnObjectPhotoRemove"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:gravity="center"
                android:text="@string/object_photo_remove"
                android:visibility="gone"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>