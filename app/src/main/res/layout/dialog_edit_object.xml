<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/textErrorEditObject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/common_required_field"
        android:textColor="#D32F2F"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <EditText
        android:id="@+id/editObjectName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/dialog_object_name_hint"
        android:imeOptions="actionNext"
        android:inputType="textCapWords"
        android:maxLines="1"
        android:minHeight="44dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />

    <EditText
        android:id="@+id/editObjectDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="@string/dialog_object_description_hint"
        android:imeOptions="actionNext"
        android:inputType="textCapSentences"
        android:maxLines="2"
        android:minHeight="44dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />

    <EditText
        android:id="@+id/editObjectQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="@string/dialog_object_quantity_hint"
        android:imeOptions="actionDone"
        android:inputType="number"
        android:maxLines="1"
        android:minHeight="44dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />

</LinearLayout>