    <string name="guide_section_settings_title">Impostazioni</string>
    <string name="guide_section_settings_b1">Inserisci il tuo nome che apparirà nella topbar. Se usi Archivio Condiviso, sarà annotato come ultimo familiare che ha modificato un determinato box e/o il suo contenuto.</string>
