    <string name="guide_section_categories_b1">Parti dalle categorie predefinite.</string>
    <string name="guide_section_categories_b2">Puoi rinominarle, aggiungerne o eliminarle.</string>
    <string name="guide_section_categories_b3">Servono a classificare i contenitori.</string>
    <string name="guide_section_boxes_title">Contenitori e oggetti</string>
    <string name="guide_section_boxes_b1">Registra i contenitori e assegna categoria e posizione.</string>
    <string name="guide_section_boxes_b2">Apri un contenitore per aggiungere gli oggetti al suo interno.</string>
    <string name="guide_section_boxes_b3">Così sai cosa c\'è e dove si trova.</string>
    <string name="guide_section_dashboard_title">Dashboard</string>
    <string name="guide_section_dashboard_b1">Vedi i totali dell\'archivio a colpo d\'occhio.</string>
