<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:tools="http://schemas.android.com/tools">

    <style
        name="Theme.BoxManager"
        parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- PRIMARY -->
        <item name="colorPrimary">@color/primary_gradient_start</item>
        <item name="colorPrimaryVariant">@color/primary_gradient_end</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- SECONDARY -->
        <item name="colorSecondary">@color/primary_button</item>
        <item name="colorSecondaryVariant">@color/primary_button_light</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- SURFACE -->
        <item name="colorSurface">@color/card_background</item>
        <item name="android:colorBackground">@color/card_background</item>

        <!-- SYSTEM -->
        <item name="android:statusBarColor">
            @color/primary_gradient_end
        </item>

        <!-- FOUNDATION UI -->
        <item name="materialCardViewStyle">
            @style/BoxManager.Card
        </item>

        <item name="buttonStyle">
            @style/BoxManager.Button
        </item>

        <item name="android:textViewStyle">
            @style/BoxManager.Text
        </item>

        <item name="editTextStyle">
            @style/BoxManager.EditText
        </item>

    </style>

    <!-- FOUNDATION CARD -->

    <style
        name="BoxManager.Card"
        parent="Widget.MaterialComponents.CardView">

        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">3dp</item>
        <item name="strokeWidth">0dp</item>

    </style>

    <!-- FOUNDATION BUTTON -->

    <style
        name="BoxManager.Button"
        parent="Widget.MaterialComponents.Button">

        <item name="android:minHeight">44dp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">14dp</item>

    </style>

    <!-- FOUNDATION TEXT -->

    <style
        name="BoxManager.Text"
        parent="Widget.AppCompat.TextView">

        <item name="android:textColor">
            @color/text_primary
        </item>

    </style>

    <!-- FOUNDATION INPUT -->

    <style
        name="BoxManager.EditText"
        parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">

        <item name="android:minHeight">48dp</item>

    </style>

</resources>