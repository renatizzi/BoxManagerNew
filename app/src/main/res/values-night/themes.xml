<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:tools="http://schemas.android.com/tools">

    <style
        name="Theme.BoxManager"
        parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- PRIMARY -->
        <item name="colorPrimary">@color/primary_gradient_start</item>
        <item name="colorPrimaryVariant">@color/primary_gradient_end</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- SECONDARY -->
        <item name="colorSecondary">@color/primary_button</item>
        <item name="colorSecondaryVariant">@color/primary_button_light</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- SURFACE -->
        <item name="colorSurface">@color/card_background</item>
        <item name="android:colorBackground">@color/card_background</item>

        <!-- SYSTEM -->
        <item name="android:statusBarColor">
            @color/primary_gradient_end
        </item>

        <!-- APPSHELL COLORS -->

        <item name="topBarBackgroundColor">
            @color/primary_gradient_start
        </item>

        <item name="topBarTitleColor">
            @android:color/white
        </item>

        <item name="topBarSubtitleColor">
            @android:color/white
        </item>

        <item name="bottomNavBackgroundColor">
            @color/card_background
        </item>

        <item name="bottomNavActiveColor">
            @color/primary_button
        </item>

        <item name="bottomNavInactiveColor">
            @color/text_secondary
        </item>

        <!-- FOUNDATION UI -->

        <item name="materialCardViewStyle">
            @style/BoxManager.Card
        </item>

        <item name="buttonStyle">
            @style/BoxManager.Button
        </item>

        <item name="android:textViewStyle">
            @style/BoxManager.Text
        </item>

        <item name="editTextStyle">
            @style/BoxManager.EditText
        </item>

    </style>

</resources>